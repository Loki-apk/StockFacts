# Copy to .env and fill in. .env is gitignored.

# --- LLM ---
# Any OpenAI-compatible endpoint. Set MODEL (+ OPENAI_BASE_URL for a custom host).
OPENAI_API_KEY=
OPENAI_BASE_URL=            # e.g. https://your-host/v1  (omit for api.openai.com)
MODEL=gpt-4o-mini          # bare name -> routed as openai/<name>

# optional per-agent overrides (else all three use MODEL)
# NEWS_LLM=
# RISK_LLM=
# SYNTH_LLM=anthropic/claude-sonnet-5

# reasoning models burn the completion budget on hidden thinking and never emit
# the JSON the agents need. Auto-disabled for Qwen; force with 0/1.
# STOCKFACT_LLM_NO_THINK=1
# STOCKFACT_LLM_MAX_TOKENS=8000

# stream each CrewAI agent's reasoning + tool calls (python -m stockfact.main -v sets this)
# STOCKFACT_CREW_VERBOSE=1

# --- market data / news fallback (optional but recommended) ---
# FMP uses the /stable API (free tier). Used as the yfinance fallback + peer
# resolver. Set STOCKFACT_PRIMARY=fmp to make FMP the primary instead.
FMP_API_KEY=
# STOCKFACT_PRIMARY=fmp
FINNHUB_API_KEY=

# Last-resort fallback: scrape finance.yahoo.com's quote page directly instead
# of going through the yfinance/FMP APIs. Brittle (depends on Yahoo's page
# markup) and more ToS-sensitive than the API-based providers — off by default.
# STOCKFACT_ENABLE_YAHOO_SCRAPE=1

# --- SEC EDGAR requires a descriptive UA: "name email" ---
SEC_USER_AGENT=your name your@email

# --- behaviour ---
# STOCKFACT_SKIP_LLM=1        # deterministic layer only
# STOCKFACT_CACHE_DB=cache/stock_cache.db
# STOCKFACT_RUNS_DB=cache/runs.db
